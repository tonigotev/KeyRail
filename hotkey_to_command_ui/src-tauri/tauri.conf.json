{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hotkey To Command",
  "version": "0.1.0",
  "identifier": "local.hotkey-to-command",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hotkey To Command",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": []
  }
}
